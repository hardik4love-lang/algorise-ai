# Algorise AI Solutions - Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME="Algorise AI Solutions"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"

# API
API_HOST="0.0.0.0"
API_PORT=8000
API_WORKERS=1

# Database (PostgreSQL)
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL="postgresql+asyncpg://algorise:testpass@localhost:5432/algorise"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# Redis
REDIS_URL="redis://localhost:6379/0"
REDIS_MAX_CONNECTIONS=50

# Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="your-super-secret-key-change-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# API Keys (for client authentication)
# Format: "key": {"client": "Client Name", "tier": "Enterprise|Growth", "quota": 50000}
# These are example keys - replace with your own in production
# API_KEYS='{"alg_live_test_key_9981": {"client": "Acme Corp", "tier": "Enterprise", "quota": 50000}, "alg_demo_client_key_001": {"client": "Starlight Labs", "tier": "Growth", "quota": 10000}}'

# External API Keys (optional)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=""
TELEGRAM_CHAT_ID=""

# Observability
OTEL_ENDPOINT=""
OTEL_SERVICE_NAME="algorise-ai"
PROMETHEUS_PORT=9090

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60